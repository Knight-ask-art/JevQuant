# Python virtual environments
.venv/
env/
venv/
ENV/

# Python cache & build
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg

# Testing & Linters
.pytest_cache/
.coverage
htmlcov/
.mypy_cache/
.ruff_cache/

# Sensitive data and keys
.env
.env.local
.env.*.local
*.pem
*.key

# Local databases and runtime runtime state
data/*.db
data/*.sqlite
data/*.sqlite3
data/*.json
!data/.gitkeep

# IDEs
.idea/
.vscode/
*.swp
*.swo

# The 新版本 frontend has a real source directory named lib/. The Python
# lib/ rule above is intended for build artefacts at the repository root.
!新版本/frontend/src/lib/
!新版本/frontend/src/lib/**
