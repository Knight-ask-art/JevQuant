# ---------------------------------------------------------------------------
# Remote testnet simulation - copy to ../.env on the server, fill every
# __CHANGE_ME__, and never commit the result.
#
#   cp deploy/server.env.example .env
#   $EDITOR .env
#   docker compose up -d --build
#
# The API container reads this file through `env_file`; the two compose-owned
# values (database URL, Redis URL) are injected by docker-compose.yml.
# ---------------------------------------------------------------------------

# `test` keeps the synthetic-feed option available if the server cannot reach
# a real market-data endpoint. Use `prod` only for a real deployment.
JEV_APP_ENV=test

# Docker Compose interpolation (not application settings).
POSTGRES_USER=jev
POSTGRES_PASSWORD=__CHANGE_ME_LONG_RANDOM__
POSTGRES_DB=jev

# Bind the UI to localhost and use: ssh -L 8080:127.0.0.1:8080 <user>@<host>
# Set 0.0.0.0 only behind a TLS-terminating reverse proxy.
WEB_BIND=127.0.0.1
WEB_PORT=8080

# API auth. The browser signs in with JEV_ADMIN_API_KEY and keeps an
# HttpOnly session cookie; the key itself is never stored in the browser.
JEV_AUTH_DISABLED=false
JEV_ADMIN_API_KEY=__CHANGE_ME_LONG_RANDOM__
JEV_INTERNAL_EXECUTION_KEY=__CHANGE_ME_LONG_RANDOM__
# This host is bound to 127.0.0.1 and reached only through an SSH tunnel, so the
# operator keeps the login off. Set JEV_AUTH_TUNNEL_ONLY=true together with
# JEV_AUTH_DISABLED=true. It has no effect once JEV_ENABLE_LIVE_TRADING=true.
JEV_AUTH_TUNNEL_ONLY=false
# Required before saving any model key through the UI; without it the UI
# refuses to store keys and existing plaintext keys are cleared at startup.
# Generate: python3 -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
JEV_CREDENTIAL_ENCRYPTION_KEY=

# Route: real Binance Spot Testnet execution.
JEV_TRADING_MODE=testnet
JEV_ENABLE_LIVE_TRADING=false
JEV_EXECUTION_BACKEND=paper

# Market data from the same venue as the orders. If testnet.binance.vision is
# unreachable from the server, set JEV_SYNTHETIC_MARKET=true instead; prices
# will then be synthetic while fills happen on the testnet.
JEV_SYNTHETIC_MARKET=false
JEV_DEMO_MODE=false
JEV_BINANCE_BASE_URL=https://testnet.binance.vision
JEV_BINANCE_TESTNET_BASE_URL=https://testnet.binance.vision

# Binance Spot Testnet credentials (https://testnet.binance.vision).
JEV_BINANCE_TESTNET_API_KEY=__CHANGE_ME__
JEV_BINANCE_TESTNET_API_SECRET=__CHANGE_ME__

# Mainnet keys stay empty: this host does not trade live.
JEV_BINANCE_API_KEY=
JEV_BINANCE_API_SECRET=
JEV_REQUIRE_IP_RESTRICT=true
JEV_REQUIRE_WITHDRAWALS_DISABLED=true

# Testnet accounts are small; tighten the envelope for the first run.
JEV_ALLOWED_SYMBOLS=["BTCUSDT","ETHUSDT"]
JEV_MAX_POSITION_NOTIONAL_USDT=6
# On a ~14 USDT account, 0.25 is 3.47 USDT, below the 5 USDT minimum, so
# every entry is rejected. 0.40 keeps one position inside the 6 USDT cap while
# clearing the ~5.17 USDT feasibility floor.
JEV_ENTRY_BUDGET_FRACTION=0.40
JEV_MAX_GROSS_EXPOSURE_PCT=40
JEV_JEV_MAX_CALLS_PER_UTC_MONTH=3000
JEV_MAX_POSITIONS=1

# Must equal the testnet account's tUSDT total, otherwise the first balance
# sync reports drift by construction.
JEV_PAPER_STARTING_EQUITY=14

# Balance sync + the drift-triggered reconcile.
JEV_BALANCE_SYNC_SECONDS=0
JEV_BALANCE_AUTO_RECONCILE=true
JEV_BALANCE_RECONCILE_COOLDOWN_SECONDS=300

# Start manual; raise to 60-300 after the first successful cycles.
JEV_AUTO_CYCLE_SECONDS=0

# Simulated policy/Jev by default. Fill these to use the real models; both can
# share an OpenCode Console inference-only key.
JEV_OPENCODE_CONSOLE_ENABLED=false
JEV_OPENCODE_CONSOLE_BASE_URL=
JEV_OPENCODE_CONSOLE_API_KEY=
JEV_OPENCODE_CONSOLE_MODEL=
JEV_OPENCODE_CONSOLE_PROTOCOL=openai

JEV_JEV_ENABLED=false
JEV_JEV_BASE_URL=
JEV_JEV_API_KEY=
JEV_JEV_MODEL=jev-1.13
JEV_JEV_PATH=/v1/inference

# Leave empty unless Live is being prepared; never needed for testnet.
JEV_MFA_TOTP_SECRET=
JEV_HUMMINGBOT_BASE_URL=
JEV_HUMMINGBOT_API_KEY=
