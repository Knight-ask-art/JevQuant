# JevQuant 运行模式 (paper | testnet | live)
TRADING_MODE=paper

# 实盘双重保护开关 (必须显式设为 true 并配合 CLI --confirm-live)
ENABLE_LIVE_TRADING=false

# 交易所与交易对配置
EXCHANGE=binance
SYMBOL=BTC/USDT
TIMEFRAME=1h

# 资金管理配置
# 模拟账户初始资金 (USDT)
PAPER_INITIAL_BALANCE_USDT=7.00
# 实盘初始资金 (USDT, 由用户按 50 元人民币上限手工折算存入，不自动复制)
LIVE_INITIAL_CAPITAL_USDT=

# TypeSafe Jev API 配置 (https://typesafe.ai/)
TYPESAFE_API_KEY=
JEV_MODEL=jev-latest
# 每月模型消费上限保护 (USD)
JEV_MAX_MONTHLY_COST_USD=0.50

# Binance API 凭据 (模拟盘 paper 模式下无需配置)
# Binance 实盘密钥 (受限现货，禁止提现和合约权限)
BINANCE_API_KEY=
BINANCE_API_SECRET=

# Binance Spot Testnet 测试网密钥 (与实盘严格隔离)
BINANCE_TESTNET_API_KEY=
BINANCE_TESTNET_API_SECRET=

# 监控面板配置
DASHBOARD_HOST=127.0.0.1
DASHBOARD_PORT=8501
