# ---------------------------------------------------------------------------
# Jev + LLM dual-model trading system - example configuration
# Copy to .env and edit. NEVER commit .env.
# ---------------------------------------------------------------------------
JEV_APP_ENV=dev

# Docker Compose only (ignored by the application itself). Change the database
# password on any shared host. WEB_BIND defaults to localhost: reach the UI
# through an SSH tunnel, or set 0.0.0.0 behind a TLS-terminating proxy.
POSTGRES_USER=jev
POSTGRES_PASSWORD=change-me-db-password
POSTGRES_DB=jev
WEB_BIND=127.0.0.1
WEB_PORT=8080

# Database: SQLite for local dev, PostgreSQL for staging/production.
# JEV_DATABASE_URL=sqlite+aiosqlite:///./data/jev.db
# JEV_DATABASE_URL=postgresql+asyncpg://jev:jev@localhost:5432/jev
JEV_DATABASE_URL=sqlite+aiosqlite:///./data/jev.db

# Redis Streams (optional locally; leave empty for in-memory bus)
# JEV_REDIS_URL=redis://localhost:6379/0
JEV_REDIS_URL=

# Execution backend: paper | shadow | hummingbot
JEV_EXECUTION_BACKEND=paper

# Trading mode: paper | testnet | live.  Live additionally requires
# JEV_ENABLE_LIVE_TRADING=true and a server-side arming handshake.
JEV_TRADING_MODE=paper
JEV_ENABLE_LIVE_TRADING=false

# API auth. In dev, auth can be disabled for localhost only.
JEV_AUTH_DISABLED=true
JEV_ADMIN_API_KEY=change-me-in-production
JEV_INTERNAL_EXECUTION_KEY=change-me-internal

# Server risk envelope. Actual effective limits are always the MINIMUM of
# model-proposed, account, environment and symbol limits.
JEV_MAX_POSITION_NOTIONAL_USDT=500
JEV_MAX_GROSS_EXPOSURE_PCT=20
JEV_MAX_DAILY_LOSS_PCT=2
JEV_MAX_POSITIONS=3
JEV_MAX_DRAWDOWN_PCT=5
JEV_MAX_POLICY_TTL_SECONDS=7200
JEV_ALLOWED_SYMBOLS=["BTCUSDT","ETHUSDT","SOLUSDT"]
JEV_MARKET_STALENESS_MS=5000
# Maximum age (seconds) of cached exchange filters used to admit an entry.
JEV_ENTRY_FILTER_TTL_SECONDS=60
# Exchange-account balance sync interval in seconds (testnet/live). 0 = off.
JEV_BALANCE_SYNC_SECONDS=0
# On drift, run one reconciliation for that route (per-route cooldown in seconds).
JEV_BALANCE_AUTO_RECONCILE=true
JEV_BALANCE_RECONCILE_COOLDOWN_SECONDS=300
JEV_FEE_BPS=10
JEV_SLIPPAGE_BPS=2
JEV_EXIT_SLIPPAGE_BPS=8
JEV_MIN_STOP_LOSS_BPS=20
JEV_MAX_STOP_LOSS_BPS=300

# Paper account
JEV_PAPER_STARTING_EQUITY=10000
JEV_PAPER_SEED=42

# Binance public market data (no key required for market data)
JEV_BINANCE_BASE_URL=https://api.binance.com
JEV_BINANCE_TESTNET_BASE_URL=https://testnet.binance.vision

# OpenCode Console (runtime LLM + Jev). Keys are held server-side only.
JEV_OPENCODE_CONSOLE_ENABLED=false
JEV_OPENCODE_CONSOLE_BASE_URL=
JEV_OPENCODE_CONSOLE_API_KEY=
JEV_OPENCODE_CONSOLE_MODEL=
JEV_OPENCODE_CONSOLE_PROTOCOL=openai

# OpenCode Go (coding-agent traffic only; trade_runtime is DENIED server-side)
JEV_OPENCODE_GO_ENABLED=false
JEV_OPENCODE_GO_BASE_URL=
JEV_OPENCODE_GO_API_KEY=
JEV_OPENCODE_GO_MODEL=

# Jev System One
JEV_JEV_ENABLED=false
JEV_JEV_BASE_URL=
JEV_JEV_API_KEY=
JEV_JEV_MODEL=jev-1.13
JEV_JEV_PATH=/v1/inference

# Hummingbot API (Live execution; not required for paper/testnet)
JEV_HUMMINGBOT_BASE_URL=
JEV_HUMMINGBOT_API_KEY=

# Demo: use deterministic synthetic market data + rule-based policy/Jev.
# Clearly marked as simulated in the UI and provenance.
JEV_SYNTHETIC_MARKET=true
JEV_DEMO_MODE=false

# Background cycle scheduler (seconds). 0 = manual cycles only.
JEV_AUTO_CYCLE_SECONDS=0

# Binance API credentials. Market data needs no key. Testnet keys are only
# used by the Binance Spot Testnet adapter. Live keys must be trade-only,
# withdrawal-disabled and IP-restricted; the preflight checks this.
JEV_BINANCE_API_KEY=
JEV_BINANCE_API_SECRET=
JEV_BINANCE_TESTNET_API_KEY=
JEV_BINANCE_TESTNET_API_SECRET=
JEV_REQUIRE_IP_RESTRICT=true
JEV_REQUIRE_WITHDRAWALS_DISABLED=true

# Optional TOTP secret for the second factor on the Live arming handshake.
JEV_MFA_TOTP_SECRET=
JEV_LIVE_ARMING_TTL_SECONDS=43200
